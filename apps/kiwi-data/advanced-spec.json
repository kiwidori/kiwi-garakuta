  "subcommands": [
    "query",
    "version",
    "completion",
    "man"
  ],
  "examples": [
    {
      "name": "JSONからYAMLへ",
      "args": [
        "query",
        "--in",
        "json",
        "--out",
        "yaml",
        "--config",
        "NUL"
      ],
      "stdin": "{\"name\":\"きうい\",\"count\":3}"
    },
    {
      "name": "配列を抽出",
      "args": [
        "query",
        "--in",
        "json",
        "--out",
        "json",
        "--config",
        "NUL",
        "--",
        "items.map(name)"
      ],
      "stdin": "{\"items\":[{\"name\":\"A\"},{\"name\":\"B\"}]}"
    },
    {
      "name": "PowerShell補完を生成（実行しない）",
      "args": [
        "completion",
        "powershell"
      ],
      "stdin": ""
    },
    {
      "name": "マニュアル",
      "args": [
        "man"
      ],
      "stdin": ""
    },
    {
      "name": "バージョン",
      "args": [
        "version"
      ],
      "stdin": ""
    }
  ]
