    {
      "flag": "-version",
      "aliases": [
        "-version"
      ],
      "takes_value": false,
      "description": "版とビルド情報を表示",
      "blocked": false
    },
    {
      "flag": "-help",
      "aliases": [
        "-help"
      ],
      "takes_value": false,
      "description": "CLIヘルプを表示",
      "blocked": false
    }
  ],
  "examples": [
    {
      "name": "バージョン",
      "args": [
        "-version"
      ]
    }
  ]
}
